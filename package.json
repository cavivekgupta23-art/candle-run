{
  "name": "candle-run",
  "private": true,
  "version": "0.1.0",
  "description": "Candle Run: a voxel platformer on the real Bitcoin daily chart. Run 200 candles, jump the wicks, slide the lasers, outrun the taxman.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5191 --strictPort",
    "typecheck": "tsc --noEmit",
    "check": "node tools/check_level.ts"
  },
  "dependencies": {
    "three": "0.160.0",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "@types/three": "0.160.0",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
